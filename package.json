{
  "name": "@zephyr-777/dsh-smart-title",
  "version": "0.3.0",
  "description": "dsh 插件 · 会话智能标题（合并版）：参考 dsh-session-autoname 的严格命名格式，用 LLM 生成 `MMDD｜类型｜主题` 形式的会话标题；首条消息即时出题、每轮结束按完整转写与工具痕迹重刷、占位标题自动升级、fork 分支后缀、启动回扫、刷新节流与长会话冻结、同题静默跳过、用户手动改名不被覆盖、标题模型可单独指定、设置页可视化配置。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session-title",
    "title",
    "llm"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zephyr-777/dsh-smart-title.git"
  },
  "homepage": "https://github.com/Zephyr-777/dsh-smart-title#readme",
  "bugs": {
    "url": "https://github.com/Zephyr-777/dsh-smart-title/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
